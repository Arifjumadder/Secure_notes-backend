PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/secure-notes?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma separated list of allowed frontend origins (no trailing slash)
CLIENT_URL=http://localhost:5173
# Optional: auto-create the first admin on startup (needed on Render free tier, no shell)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
