            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/notes/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notes",
                "{{id}}"
              ]
            }
          }
        },
        {
          "name": "Update note",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/notes/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notes",
                "{{id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated\"\n}"
            }
          }
        },
        {
          "name": "Delete note",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/notes/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notes",
                "{{id}}"
              ]
            }
          }
        },
        {
          "name": "Admin: all notes",
          "request": {
            "method": "GET",
